<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Add a car part · Inventory</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
	<main>
		<header class="header">
			<h1>Add a car part</h1>
			<p class="subtitle">Enter the part details to add it to your inventory.</p>
		</header>

		<section class="card form-card" aria-labelledby="form-heading">
			<div class="card-heading">
				<h2 id="form-heading">Part details</h2>
			</div>
			<form class="item-form" action="/create" method="post">
				<label for="name">Name</label>
				<input id="name" name="name" type="text" required>

				<label for="category">Category</label>
				<input id="category" name="category" type="text">

				<label for="brand">Brand</label>
				<input id="brand" name="brand" type="text">

				<label for="part_number">Part number</label>
				<input id="part_number" name="part_number" type="text">

				<label for="price">Price</label>
				<input id="price" name="price" type="number" min="0" step="0.01" required>

				<label for="quantity">Quantity</label>
				<input id="quantity" name="quantity" type="number" min="0" step="1" required>

				<label for="description">Description</label>
				<textarea id="description" name="description" rows="4"></textarea>

				<div class="form-actions">
					<button class="button" type="submit">Save part</button>
					<a class="button button-secondary" href="/">Cancel</a>
				</div>
			</form>
		</section>
	</main>
</body>
</html>
